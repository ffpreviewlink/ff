---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { ui, home, locale, langs, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
  title: string;
  description: string;
  path: string;
  jsonld?: object[];
  noindex?: boolean;
  /** Equivalent page in each language, when it differs from the home page. */
  alt?: Record<Lang, string>;
}
const { lang = "en", title, description, path, jsonld = [], noindex = false, alt = home } = Astro.props;
const t = ui[lang];
const site = "https://federicofuffa.it";
const url = site + path;
const image = site + "/og.png";
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={url} />}
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && langs.map((l) => <link rel="alternate" hreflang={l} href={site + alt[l]} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={site + alt.en} />}
    <meta name="theme-color" content="#f3f1ec" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Federico Fuffa" />
    <meta property="og:locale" content={locale[lang]} />
    {!noindex && langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={locale[l]} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="preload" href="/fonts/inter-tight.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function () {
        document.documentElement.classList.add("js");
      })();
    </script>
    {jsonld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body id="top">
    <a class="skip" href="#main">{t.skip}</a>
    <Header lang={lang} alt={alt} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieBanner lang={lang} />
    <script src="../scripts/motion.js"></script>
  </body>
</html>
