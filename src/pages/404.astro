---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found · Federico Fuffa" description="This page does not exist." path="/404/" noindex>
  <section class="nf">
    <div class="wrap">
      <p class="mono">Error 404</p>
      <h1>Not<br>found</h1>
      <p>This page does not exist.<br><span lang="it">Questa pagina non esiste.</span></p>
      <div class="nf-actions">
        <a class="store visit" href="/"><span>Back home</span><span class="arr" aria-hidden="true">→</span></a>
        <a class="store visit" href="/it/" lang="it"><span>Torna alla home</span><span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>
