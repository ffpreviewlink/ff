---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found · Federico Fuffa" description="This page does not exist." path="/404/" noindex>
  <section class="nf">
    <div class="wrap">
      <p class="mono">Error 404</p>
      <h1>Not<br>found</h1>
      <p>This page does not exist.<br><span lang="it">Questa pagina non esiste.</span></p>
      <a class="btn" href="/"><span class="btn-t">Back home</span><span class="arr" aria-hidden="true">→</span></a>
      <a class="btn" href="/it/" lang="it" style="margin-left:12px"><span class="btn-t">Torna alla home</span><span class="arr" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
