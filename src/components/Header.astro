---
import { ui, home, langs, type Lang } from "../i18n/ui";
const { lang = "en", alt = home } = Astro.props as { lang?: Lang; alt?: Record<Lang, string> };
const t = ui[lang];
const base = home[lang];
const names: Record<Lang, string> = { en: "English", it: "Italiano" };
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={base} aria-label={t.brandLabel}><img class="brand-logo" src="/logo.webp" width="32" height="32" alt="" decoding="async" /><span>Federico Fuffa</span></a>
    <nav class="nav" aria-label={t.navLabel}>
      <a href={base + "#work"}>{t.nav.work}</a>
      <a class="nav-rv" href={base + "#reviews"}>{t.nav.reviews}</a>
      <a href={base + "#about"}>{t.nav.about}</a>
      <a href={base + "#contact"}>{t.nav.contact}</a>
      <div class="lang" role="group" aria-label={t.langLabel}>
        {langs.map((l, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true">/</span>}
            {l === lang
              ? <a href={alt[l]} lang={l} hreflang={l} aria-label={names[l]} aria-current="true">{l.toUpperCase()}</a>
              : <a href={alt[l]} lang={l} hreflang={l} aria-label={names[l]} title={names[l]}>{l.toUpperCase()}</a>}
          </>
        ))}
      </div>
    </nav>
  </div>
</header>
