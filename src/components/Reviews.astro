---
import { getCollection } from "astro:content";
import { ui, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].reviews;

const PROFILE = "https://www.trustpilot.com/review/federicofuffa.it";
const EVALUATE = "https://www.trustpilot.com/evaluate/federicofuffa.it";
// Trustpilot shows a weighted score while a profile has few reviews: below this many reviews
// only the count is shown, so the number here never contradicts the one on Trustpilot.
const MIN_FOR_AVERAGE = 3;

// Reviews are copied by hand from Trustpilot (see src/content/reviews/README.md), so there is no
// fetch or cache. Order is editorial: `order` first (lowest leads), then newest. Authors' names are
// never rendered: each review is attributed by project (if any) and a short descriptor instead.
const reviews = (await getCollection("reviews"))
  .map((r) => r.data)
  .sort((a, b) => a.order - b.order || b.date.getTime() - a.date.getTime());
const n = reviews.length;
const avg = n ? reviews.reduce((s, r) => s + r.rating, 0) / n : 0;
const avgText = avg.toLocaleString(lang === "it" ? "it-IT" : "en-GB", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const count = n === 1 ? t.one : t.many.replace("{n}", String(n));
const dateFmt = new Intl.DateTimeFormat(lang === "it" ? "it-IT" : "en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const iso = (d: Date) => d.toISOString().slice(0, 10);
const star = "M12 2.5l2.95 6.2 6.8.85-5 4.7 1.3 6.75L12 17.6 5.95 21l1.3-6.75-5-4.7 6.8-.85z";
---
{n > 0 && (
  <section id="reviews" aria-labelledby="r-h">
    <div class="wrap">
      <div class="frame"><h2 class="label" id="r-h">{t.label}</h2>
        <div>
          <div class="r-head rv">
            <p class="r-sum">
              {n >= MIN_FOR_AVERAGE ? (
                <>
                  <span class="stars" role="img" aria-label={t.avgAria.replace("{avg}", avgText).replace("{n}", String(n))}>
                    <span class="r-avg" aria-hidden="true">{avgText}</span>
                    <svg viewBox="0 0 120 24" width="120" height="24" aria-hidden="true">
                      <defs><clipPath id="r-clip"><rect x="0" y="0" width={(avg / 5) * 120} height="24" /></clipPath></defs>
                      <g class="r-off">{[0, 1, 2, 3, 4].map((i) => <path d={star} transform={`translate(${i * 24} 0)`} />)}</g>
                      <g class="r-on" clip-path="url(#r-clip)">{[0, 1, 2, 3, 4].map((i) => <path d={star} transform={`translate(${i * 24} 0)`} />)}</g>
                    </svg>
                  </span>
                  <span class="r-count" aria-hidden="true">{t.avgOf.replace("{n}", String(n))}</span>
                </>
              ) : (
                <span class="r-count">{count} {t.source}</span>
              )}
            </p>
            <p class="r-lede"><a class="ul r-prof" href={PROFILE} target="_blank" rel="noopener noreferrer">{t.profile} <span aria-hidden="true">↗</span></a></p>
          </div>

          <ul class="r-list" aria-label={t.listAria}>
            {reviews.map((r, i) => (
              <li class={i === 0 ? "rv r-lead" : "rv"} style={`--d:${i % 3}`}>
                <article class="r-card">
                  <div class="r-top">
                    <span class="r-idx mono" aria-hidden="true">{String(i + 1).padStart(2, "0")} / {String(n).padStart(2, "0")}</span>
                    <span class="stars" role="img" aria-label={t.starsAria.replace("{n}", String(r.rating))}>
                      <svg viewBox="0 0 120 24" width="120" height="24" aria-hidden="true">
                        {[0, 1, 2, 3, 4].map((k) => <path class={k < r.rating ? "r-on" : "r-off"} d={star} transform={`translate(${k * 24} 0)`} />)}
                      </svg>
                    </span>
                  </div>
                  <h3 lang={r.lang}>{r.title}</h3>
                  <blockquote lang={r.lang}>{r.text.split("\n").filter((line, k) => !(k === 0 && line === r.title)).map((line) => <p>{line}</p>)}</blockquote>
                  <footer>
                    <p class="r-who">
                      {r.project ? <b>{r.project}</b> : r.showAuthor && <b>{r.author}</b>}
                      <span>{r.descriptor?.[lang] ?? t.anon}</span>
                    </p>
                    <p class="r-meta">
                      <time datetime={iso(r.date)}>{dateFmt.format(r.date)}</time>
                      <a class="ul r-read" href={r.url} target="_blank" rel="noopener noreferrer" aria-label={`${t.read}: ${r.project ?? r.descriptor?.[lang] ?? r.title}`}>{t.read} <span aria-hidden="true">↗</span></a>
                    </p>
                  </footer>
                </article>
              </li>
            ))}
          </ul>

          <div class="r-actions rv">
            <a class="store visit" href={PROFILE} target="_blank" rel="noopener noreferrer"><span>{t.all}</span><span class="arr" aria-hidden="true">↗</span></a>
            <a class="ul r-leave" href={EVALUATE} target="_blank" rel="noopener noreferrer">{t.leave} <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>
)}
