---
import { ui, type Lang } from "../i18n/ui";
const { lang = "en" } = Astro.props as { lang?: Lang };
const t = ui[lang].footer;
---
<footer class="site-footer">
  <div class="wrap foot">
    <div>
      <p class="copy"><span>{t.copy}</span> <span>{t.rights}</span></p>
      <p class="role">{t.role} <a href="https://www.plintolabs.it/" target="_blank" rel="noopener">Plinto Labs</a></p>
    </div>
    <p><a href="#top">{t.top}</a></p>
  </div>
</footer>
